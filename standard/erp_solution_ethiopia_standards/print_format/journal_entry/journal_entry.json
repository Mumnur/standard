 "doc_type": "Journal Entry",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n\n    /* =========================================================\n       PAGE SETUP\n       ========================================================= */\n\n    @page {\n        size: A4;\n        margin: 14mm 10mm 16mm 10mm;\n    }\n\n    body {\n        font-family: Arial, Helvetica, sans-serif;\n        font-size: 11px;\n        line-height: 1.45;\n        color: #222;\n        margin: 0;\n        padding: 0;\n    }\n\n    * {\n        box-sizing: border-box;\n    }\n\n    .print-format {\n        padding: 8px 12px;\n    }\n\n\n    /* =========================================================\n       HEADER\n       ========================================================= */\n\n    .header-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 4px;\n    }\n\n    .header-table td {\n        border: none !important;\n        vertical-align: middle;\n    }\n\n    .header-table .logo {\n        width: 80px;\n        height: auto;\n        max-height: 65px;\n        object-fit: contain;\n    }\n\n    .company-name {\n        font-size: 18px;\n        font-weight: bold;\n        color: #111;\n        letter-spacing: 0.4px;\n        margin-bottom: 4px;\n    }\n\n    .company-sub {\n        display: inline-block;\n        font-size: 12px;\n        font-weight: bold;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n        color: #111;\n        background: #f0f0f0;\n        border: 1px solid #999;\n        border-radius: 3px;\n        padding: 3px 12px;\n    }\n\n    .document-info {\n        font-size: 9.5px;\n        line-height: 1.8;\n        text-align: left;\n        color: #222;\n    }\n\n    .document-info b {\n        color: #111;\n    }\n\n    .header-accent {\n        border-top: 3px solid #333;\n        border-bottom: 1px solid #999;\n        margin: 6px 0 12px 0;\n    }\n\n\n    /* =========================================================\n       ENTRY INFORMATION\n       ========================================================= */\n\n    .info-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 14px;\n    }\n\n    .info-table td {\n        border: 1px solid #999;\n        padding: 6px 8px;\n        vertical-align: middle;\n        font-size: 10.5px;\n    }\n\n    .info-table td:nth-child(odd) {\n        background: #f2f2f2;\n        font-weight: bold;\n        color: #111;\n        width: 18%;\n    }\n\n    .info-table td:nth-child(even) {\n        width: 32%;\n    }\n\n    .info-table .purpose-label {\n        width: 18%;\n        background: #f2f2f2;\n        font-weight: bold;\n        color: #111;\n    }\n\n    .info-table .purpose-value {\n        width: 82%;\n    }\n\n\n    /* =========================================================\n       ACCOUNTS TABLE\n       ========================================================= */\n\n    .report-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 6px;\n        margin-bottom: 18px;\n    }\n\n    .report-table thead {\n        display: table-header-group;\n    }\n\n    .report-table tfoot {\n        display: table-row-group;\n    }\n\n    .report-table th {\n        background: #e2e2e2;\n        color: #111;\n        border: 1px solid #666;\n        padding: 7px 6px;\n        text-align: left;\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        letter-spacing: 0.3px;\n        vertical-align: middle;\n    }\n\n    .report-table td {\n        border: 1px solid #999;\n        padding: 6px;\n        font-size: 10px;\n        vertical-align: top;\n        word-break: break-word;\n    }\n\n    .report-table tbody tr {\n        page-break-inside: avoid;\n    }\n\n    .report-table tbody tr:not(.total):nth-child(even) {\n        background: #f5f5f5;\n    }\n\n    .report-table .sn {\n        text-align: center;\n        color: #444;\n        white-space: nowrap;\n    }\n\n    .report-table .amount {\n        text-align: right;\n        white-space: nowrap;\n        font-variant-numeric: tabular-nums;\n    }\n\n    .report-table .empty-row td {\n        text-align: center;\n        color: #777;\n        font-style: italic;\n        padding: 14px;\n    }\n\n    .report-table .total td {\n        font-weight: bold;\n        background: #e8e8e8;\n        border-top: 2px solid #333;\n        border-bottom: 2px solid #333;\n        color: #111;\n    }\n\n    .report-table .total td:first-child {\n        text-align: right;\n    }\n\n\n    /* =========================================================\n       APPROVAL SECTION\n       COMPACT VERSION\n       ========================================================= */\n\n    .approval-title {\n        text-align: center;\n        font-size: 11px;\n        font-weight: bold;\n        text-transform: uppercase;\n        letter-spacing: 0.4px;\n        margin-top: 8px;\n        margin-bottom: 4px;\n        padding: 3px 6px;\n        border: 1px solid #333;\n        background: #efefef;\n        color: #111;\n        border-radius: 2px;\n    }\n\n    .approval-block {\n        page-break-inside: avoid;\n    }\n\n    .approval-table {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n    }\n\n    .approval-table th {\n        border: 1px solid #666;\n        background: #e2e2e2;\n        color: #111;\n        padding: 3px 4px;\n        text-align: center;\n        font-size: 9px;\n        font-weight: bold;\n        text-transform: uppercase;\n        letter-spacing: 0.2px;\n    }\n\n    .approval-table td {\n        border: 1px solid #999;\n        padding: 3px 4px;\n        vertical-align: middle;\n    }\n\n    /* ---------------------------------------------------------\n       INNER NAME / DATE TABLE\n       --------------------------------------------------------- */\n\n    .approval-info {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 0;\n        padding: 0;\n    }\n\n    .approval-info td {\n        border: none !important;\n        padding: 1px 3px;\n        vertical-align: middle;\n    }\n\n    .approval-label {\n        width: 20%;\n        font-weight: bold;\n        background: transparent;\n        font-size: 8.5px;\n        color: #555;\n        white-space: nowrap;\n    }\n\n    .approval-value {\n        width: 80%;\n        font-size: 9px;\n        padding: 1px 3px !important;\n    }\n\n    .approval-name {\n        font-weight: bold;\n        font-size: 9px;\n    }\n\n    .approval-date {\n        text-align: left;\n        font-size: 8.5px;\n    }\n\n    /* ---------------------------------------------------------\n       SIGNATURE\n       --------------------------------------------------------- */\n\n    .signature-cell {\n        height: 38px;\n        padding: 2px 4px !important;\n        text-align: center;\n        vertical-align: middle !important;\n    }\n\n    .signature-image {\n        max-width: 110px;\n        max-height: 30px;\n        object-fit: contain;\n    }\n\n    .signature-placeholder {\n        color: #aaa;\n        font-size: 8px;\n        font-style: italic;\n    }\n\n\n    /* =========================================================\n       FOOTER\n       ========================================================= */\n\n    .footer {\n        width: 100%;\n        text-align: center;\n        font-size: 8.5px;\n        color: #777;\n        border-top: 1px solid #c7d2d8;\n        padding-top: 5px;\n        margin-top: 18px;\n    }\n\n\n    /* =========================================================\n       PRINT SETTINGS\n       ========================================================= */\n\n    @media print {\n\n        .header-table,\n        .info-table,\n        .approval-block {\n            page-break-inside: avoid;\n        }\n\n        .report-table {\n            page-break-inside: auto;\n        }\n\n        .approval-title {\n            page-break-after: avoid;\n        }\n\n        .approval-block {\n            page-break-before: avoid;\n        }\n\n        thead {\n            display: table-header-group;\n        }\n\n        tr {\n            page-break-inside: avoid;\n        }\n    }\n\n</style>\n\n\n<!-- =========================================================\n     HEADER\n     ========================================================= -->\n\n<table class=\"header-table\">\n    <tr>\n\n        <!-- LOGO -->\n        <td style=\"width:100px;\">\n            <img\n                src=\"/files/wwc-logo-new.png\"\n                class=\"logo\"\n            >\n        </td>\n\n        <!-- COMPANY NAME -->\n        <td style=\"text-align:center;\">\n\n            <div class=\"company-name\">\n                WATER WORKS CORPORATION\n            </div>\n\n            <div class=\"company-sub\">\n                Journal Entry\n            </div>\n\n        </td>\n\n        <!-- DOCUMENT INFORMATION -->\n        <td style=\"width:180px;\">\n\n            <div class=\"document-info\">\n\n                <b>Document No:</b>\n                {{ doc.name }}\n\n                <br>\n\n                <b>Print Date:</b>\n                {{ frappe.utils.now_datetime().strftime(\"%d-%m-%Y %H:%M\") }}\n\n                <br>\n\n                <b>Total Lines:</b>\n                {{ doc.accounts | length }}\n\n            </div>\n\n        </td>\n\n    </tr>\n</table>\n\n\n<div class=\"header-accent\"></div>\n\n\n<!-- =========================================================\n     ENTRY INFORMATION\n     ========================================================= -->\n\n<table class=\"info-table\">\n\n    <tr>\n\n        <td>\n            <b>Entry Type</b>\n        </td>\n\n        <td>\n            {{ doc.voucher_type or \"\" }}\n        </td>\n\n        <td>\n            <b>Series</b>\n        </td>\n\n        <td>\n            {{ doc.name or \"\" }}\n        </td>\n\n    </tr>\n\n    <tr>\n\n        <td>\n            <b>Branch</b>\n        </td>\n\n        <td>\n            {{ doc.company_branch or \"\" }}\n        </td>\n\n        <td>\n            <b>Posting Date</b>\n        </td>\n\n        <td>\n            {{ doc.posting_date or \"\" }}\n        </td>\n\n    </tr>\n\n    <!-- PURPOSE - FULL ROW -->\n\n    <tr>\n\n        <td class=\"purpose-label\">\n            Purpose\n        </td>\n\n        <td colspan=\"3\" class=\"purpose-value\">\n            {{ doc.custom_purpose or \"\" }}\n        </td>\n\n    </tr>\n\n</table>\n\n\n<!-- =========================================================\n     ACCOUNTS TABLE\n     ========================================================= -->\n\n<table class=\"report-table\">\n\n    <thead>\n\n        <tr>\n\n            <th style=\"width:5%; text-align:center;\">\n                S/N\n            </th>\n\n            <th style=\"width:21%;\">\n                Account\n            </th>\n\n            <th style=\"width:14%;\">\n                Party\n            </th>\n\n            <th style=\"width:16%;\">\n                Cost Center\n            </th>\n\n            <th style=\"width:13%;\">\n                Project\n            </th>\n\n            <th style=\"width:15.5%; text-align:right;\">\n                Debit\n            </th>\n\n            <th style=\"width:15.5%; text-align:right;\">\n                Credit\n            </th>\n\n        </tr>\n\n    </thead>\n\n\n    <tbody>\n\n        {% if doc.accounts %}\n\n            {% for d in doc.accounts %}\n\n            <tr>\n\n                <td class=\"sn\">\n                    {{ loop.index }}\n                </td>\n\n                <td>\n                    {{ d.account or \"\" }}\n                </td>\n\n                <td>\n                    {{ d.party or \"\" }}\n                </td>\n\n                <td>\n                    {{ d.cost_center or \"\" }}\n                </td>\n\n                <td>\n                    {{ d.project or \"\" }}\n                </td>\n\n                <td class=\"amount\">\n                    {{ frappe.utils.fmt_money(d.debit or 0) }}\n                </td>\n\n                <td class=\"amount\">\n                    {{ frappe.utils.fmt_money(d.credit or 0) }}\n                </td>\n\n            </tr>\n\n            {% endfor %}\n\n        {% else %}\n\n            <tr class=\"empty-row\">\n\n                <td colspan=\"7\">\n                    No account entries recorded\n                </td>\n\n            </tr>\n\n        {% endif %}\n\n\n        <!-- TOTAL -->\n\n        <tr class=\"total\">\n\n            <td colspan=\"5\">\n                Total\n            </td>\n\n            <td class=\"amount\">\n                {{ frappe.utils.fmt_money(doc.total_debit or 0) }}\n            </td>\n\n            <td class=\"amount\">\n                {{ frappe.utils.fmt_money(doc.total_credit or 0) }}\n            </td>\n\n        </tr>\n\n    </tbody>\n\n</table>\n\n\n<!-- =========================================================\n     APPROVAL SECTION\n     ========================================================= -->\n\n<div class=\"approval-block\">\n\n    <div class=\"approval-title\">\n        Approval & Authorization\n    </div>\n\n\n    <!-- =====================================================\n         2-COLUMN APPROVAL\n\n         Cash Receipt Voucher\n         Receipt Voucher\n         Journal Voucher\n         ===================================================== -->\n\n    {% if doc.voucher_type in [\n        \"Cash Receipt Voucher\",\n        \"Receipt Voucher\",\n        \"Journal Voucher\"\n    ] %}\n\n    <table class=\"approval-table\">\n\n        <!-- HEADERS -->\n\n        <tr>\n\n            <th width=\"50%\">\n                PREPARED BY\n            </th>\n\n            <th width=\"50%\">\n                AUTHORIZED BY\n            </th>\n\n        </tr>\n\n\n        <!-- NAME -->\n\n        <tr>\n\n            <!-- PREPARED -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Name\n                        </td>\n\n                        <td class=\"approval-value approval-name\">\n                            {{ doc.custom_prepared_by or \"\" }}\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n\n            <!-- AUTHORIZED -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Name\n                        </td>\n\n                        <td class=\"approval-value approval-name\">\n                            {{ doc.custom_authorized_by or \"\" }}\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n        </tr>\n\n\n        <!-- SIGNATURE -->\n\n        <tr>\n\n            <!-- PREPARED SIGNATURE -->\n\n            <td class=\"signature-cell\">\n\n                {% if doc.custom_accountant_signature %}\n\n                    <img\n                        src=\"{{ doc.custom_accountant_signature }}\"\n                        class=\"signature-image\"\n                    >\n\n                {% else %}\n\n                    <span class=\"signature-placeholder\">\n                        Signature\n                    </span>\n\n                {% endif %}\n\n            </td>\n\n\n            <!-- AUTHORIZED SIGNATURE -->\n\n            <td class=\"signature-cell\">\n\n                {% if doc.custom_authorize_signature %}\n\n                    <img\n                        src=\"{{ doc.custom_authorize_signature }}\"\n                        class=\"signature-image\"\n                    >\n\n                {% else %}\n\n                    <span class=\"signature-placeholder\">\n                        Signature\n                    </span>\n\n                {% endif %}\n\n            </td>\n\n        </tr>\n\n\n        <!-- DATE -->\n\n        <tr>\n\n            <!-- PREPARED DATE -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Date\n                        </td>\n\n                        <td class=\"approval-value approval-date\">\n\n                            {% if doc.custom_prepared_date %}\n                                {{ frappe.utils.formatdate(doc.custom_prepared_date) }}\n                            {% endif %}\n\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n\n            <!-- AUTHORIZED DATE -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Date\n                        </td>\n\n                        <td class=\"approval-value approval-date\">\n\n                            {% if doc.custom_authorized_date %}\n                                {{ frappe.utils.formatdate(doc.custom_authorized_date) }}\n                            {% endif %}\n\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n        </tr>\n\n    </table>\n\n\n    <!-- =====================================================\n         3-COLUMN APPROVAL\n\n         Petty Cash Payment Voucher\n         ===================================================== -->\n\n    {% elif doc.voucher_type == \"Petty Cash Payment Voucher\" %}\n\n    <table class=\"approval-table\">\n\n        <!-- HEADERS -->\n\n        <tr>\n\n            <th width=\"33.33%\">\n                PREPARED BY\n            </th>\n\n            <th width=\"33.33%\">\n                AUTHORIZED BY\n            </th>\n\n            <th width=\"33.33%\">\n                RECEIVED BY\n            </th>\n\n        </tr>\n\n\n        <!-- NAME -->\n\n        <tr>\n\n            <!-- PREPARED -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Name\n                        </td>\n\n                        <td class=\"approval-value approval-name\">\n                            {{ doc.custom_prepared_by or \"\" }}\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n\n            <!-- AUTHORIZED -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Name\n                        </td>\n\n                        <td class=\"approval-value approval-name\">\n                            {{ doc.custom_authorized_by or \"\" }}\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n\n            <!-- RECEIVED - MANUAL -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Name\n                        </td>\n\n                        <td class=\"approval-value approval-name\">\n                            &nbsp;\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n        </tr>\n\n\n        <!-- SIGNATURE -->\n\n        <tr>\n\n            <!-- PREPARED SIGNATURE -->\n\n            <td class=\"signature-cell\">\n\n                {% if doc.custom_accountant_signature %}\n\n                    <img\n                        src=\"{{ doc.custom_accountant_signature }}\"\n                        class=\"signature-image\"\n                    >\n\n                {% else %}\n\n                    <span class=\"signature-placeholder\">\n                        Signature\n                    </span>\n\n                {% endif %}\n\n            </td>\n\n\n            <!-- AUTHORIZED SIGNATURE -->\n\n            <td class=\"signature-cell\">\n\n                {% if doc.custom_authorize_signature %}\n\n                    <img\n                        src=\"{{ doc.custom_authorize_signature }}\"\n                        class=\"signature-image\"\n                    >\n\n                {% else %}\n\n                    <span class=\"signature-placeholder\">\n                        Signature\n                    </span>\n\n                {% endif %}\n\n            </td>\n\n\n            <!-- RECEIVED SIGNATURE - MANUAL -->\n\n            <td class=\"signature-cell\">\n\n                <span class=\"signature-placeholder\">\n                    Signature\n                </span>\n\n            </td>\n\n        </tr>\n\n\n        <!-- DATE -->\n\n        <tr>\n\n            <!-- PREPARED DATE -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Date\n                        </td>\n\n                        <td class=\"approval-value approval-date\">\n\n                            {% if doc.custom_prepared_date %}\n                                {{ frappe.utils.formatdate(doc.custom_prepared_date) }}\n                            {% endif %}\n\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n\n            <!-- AUTHORIZED DATE -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Date\n                        </td>\n\n                        <td class=\"approval-value approval-date\">\n\n                            {% if doc.custom_authorized_date %}\n                                {{ frappe.utils.formatdate(doc.custom_authorized_date) }}\n                            {% endif %}\n\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n\n            <!-- RECEIVED DATE - MANUAL -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Date\n                        </td>\n\n                        <td class=\"approval-value approval-date\">\n                            &nbsp;\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n        </tr>\n\n    </table>\n\n\n    <!-- =====================================================\n         DEFAULT 3-COLUMN APPROVAL\n\n         All Other Voucher Types\n         ===================================================== -->\n\n    {% else %}\n\n    <table class=\"approval-table\">\n\n        <!-- HEADERS -->\n\n        <tr>\n\n            <th width=\"33.33%\">\n                PREPARED BY\n            </th>\n\n            <th width=\"33.33%\">\n                APPROVED BY\n            </th>\n\n            <th width=\"33.33%\">\n                AUTHORIZED BY\n            </th>\n\n        </tr>\n\n\n        <!-- NAME -->\n\n        <tr>\n\n            <!-- PREPARED -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Name\n                        </td>\n\n                        <td class=\"approval-value approval-name\">\n                            {{ doc.custom_prepared_by or \"\" }}\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n\n            <!-- APPROVED -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Name\n                        </td>\n\n                        <td class=\"approval-value approval-name\">\n                            {{ doc.custom_approved_by or \"\" }}\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n\n            <!-- AUTHORIZED -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Name\n                        </td>\n\n                        <td class=\"approval-value approval-name\">\n                            {{ doc.custom_authorized_by or \"\" }}\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n        </tr>\n\n\n        <!-- SIGNATURE -->\n\n        <tr>\n\n            <!-- PREPARED SIGNATURE -->\n\n            <td class=\"signature-cell\">\n\n                {% if doc.custom_accountant_signature %}\n\n                    <img\n                        src=\"{{ doc.custom_accountant_signature }}\"\n                        class=\"signature-image\"\n                    >\n\n                {% else %}\n\n                    <span class=\"signature-placeholder\">\n                        Signature\n                    </span>\n\n                {% endif %}\n\n            </td>\n\n\n            <!-- APPROVED SIGNATURE -->\n\n            <td class=\"signature-cell\">\n\n                {% if doc.custom_approver_signature %}\n\n                    <img\n                        src=\"{{ doc.custom_approver_signature }}\"\n                        class=\"signature-image\"\n                    >\n\n                {% else %}\n\n                    <span class=\"signature-placeholder\">\n                        Signature\n                    </span>\n\n                {% endif %}\n\n            </td>\n\n\n            <!-- AUTHORIZED SIGNATURE -->\n\n            <td class=\"signature-cell\">\n\n                {% if doc.custom_authorize_signature %}\n\n                    <img\n                        src=\"{{ doc.custom_authorize_signature }}\"\n                        class=\"signature-image\"\n                    >\n\n                {% else %}\n\n                    <span class=\"signature-placeholder\">\n                        Signature\n                    </span>\n\n                {% endif %}\n\n            </td>\n\n        </tr>\n\n\n        <!-- DATE -->\n\n        <tr>\n\n            <!-- PREPARED DATE -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Date\n                        </td>\n\n                        <td class=\"approval-value approval-date\">\n\n                            {% if doc.custom_prepared_date %}\n                                {{ frappe.utils.formatdate(doc.custom_prepared_date) }}\n                            {% endif %}\n\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n\n            <!-- APPROVED DATE -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Date\n                        </td>\n\n                        <td class=\"approval-value approval-date\">\n\n                            {% if doc.custom_approved_date %}\n                                {{ frappe.utils.formatdate(doc.custom_approved_date) }}\n                            {% endif %}\n\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n\n            <!-- AUTHORIZED DATE -->\n\n            <td>\n\n                <table class=\"approval-info\">\n\n                    <tr>\n\n                        <td class=\"approval-label\">\n                            Date\n                        </td>\n\n                        <td class=\"approval-value approval-date\">\n\n                            {% if doc.custom_authorized_date %}\n                                {{ frappe.utils.formatdate(doc.custom_authorized_date) }}\n                            {% endif %}\n\n                        </td>\n\n                    </tr>\n\n                </table>\n\n            </td>\n\n        </tr>\n\n    </table>\n\n    {% endif %}\n\n</div>\n\n\n<!-- =========================================================\n     FOOTER\n     ========================================================= -->\n\n<div class=\"footer\">\n\n    Water Works Corporation\n    \u2022\n    Journal Entry\n    \u2022\n    Generated From ERP Solution\n    \u2022\n    For More Info: +251 914199288\n\n</div>\n",
 "idx": 0,
 "line_breaks": 0,
 "margin_bottom": 15.0,
