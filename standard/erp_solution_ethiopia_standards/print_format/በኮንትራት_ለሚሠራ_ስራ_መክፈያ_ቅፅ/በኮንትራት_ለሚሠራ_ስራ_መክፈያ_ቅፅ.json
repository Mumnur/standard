{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-08-20 10:50:43.315648",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Contract Work Payment Form",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 12mm 12mm 18mm 12mm;\r\n    }\r\n\r\n    * {\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    body {\r\n        font-family: Arial, Helvetica, sans-serif;\r\n        font-size: 10px;\r\n        color: #222;\r\n        margin: 0;\r\n        padding: 0;\r\n    }\r\n\r\n    .print-format {\r\n        width: 100%;\r\n        margin: 0;\r\n        padding: 0;\r\n    }\r\n\r\n    /* =====================================================\r\n       COMPANY HEADER\r\n       ===================================================== */\r\n\r\n    .company-header {\r\n        width: 100%;\r\n        border-bottom: 2px solid #222;\r\n        padding-bottom: 7px;\r\n        margin-bottom: 9px;\r\n    }\r\n\r\n    .header-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .header-table td {\r\n        border: none;\r\n        padding: 0;\r\n    }\r\n\r\n    .header-logo {\r\n        width: 18%;\r\n        text-align: left;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .header-logo .logo {\r\n        width: 82px;\r\n        max-height: 72px;\r\n        object-fit: contain;\r\n    }\r\n\r\n    .header-company {\r\n        width: 62%;\r\n        text-align: center;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .company-name {\r\n        font-size: 19px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        margin-bottom: 3px;\r\n    }\r\n\r\n    .company-subtitle {\r\n        font-size: 11px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        margin-bottom: 3px;\r\n    }\r\n\r\n    .company-address {\r\n        font-size: 8.5px;\r\n    }\r\n\r\n    .header-right {\r\n        width: 20%;\r\n        text-align: right;\r\n        vertical-align: middle;\r\n        font-size: 8px;\r\n        line-height: 1.4;\r\n    }\r\n\r\n    /* =====================================================\r\n       DOCUMENT TITLE\r\n       ===================================================== */\r\n\r\n    .document-title {\r\n        text-align: center;\r\n        font-size: 14px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        margin: 7px 0 9px 0;\r\n        text-decoration: underline;\r\n    }\r\n\r\n    /* =====================================================\r\n       GENERAL INFORMATION\r\n       ===================================================== */\r\n\r\n    .info-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-bottom: 9px;\r\n    }\r\n\r\n    .info-table td {\r\n        border: 1px solid #555;\r\n        padding: 5px 6px;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .info-label {\r\n        width: 17%;\r\n        font-weight: bold;\r\n        background: #f1f1f1;\r\n    }\r\n\r\n    .info-value {\r\n        width: 33%;\r\n    }\r\n\r\n    /* =====================================================\r\n       SECTION TITLE\r\n       ===================================================== */\r\n\r\n    .section-title {\r\n        font-size: 10.5px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        margin-top: 8px;\r\n        margin-bottom: 5px;\r\n        padding: 5px 6px;\r\n        border: 1px solid #333;\r\n        background: #eeeeee;\r\n    }\r\n\r\n    /* =====================================================\r\n       MAIN PAYMENT TABLE\r\n       ===================================================== */\r\n\r\n    .payment-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .payment-table thead {\r\n        display: table-header-group;\r\n    }\r\n\r\n    .payment-table th {\r\n        border: 1px solid #333;\r\n        background: #e8e8e8;\r\n        padding: 5px 3px;\r\n        font-weight: bold;\r\n        text-align: center;\r\n        vertical-align: middle;\r\n        font-size: 8px;\r\n    }\r\n\r\n    .payment-table td {\r\n        border: 1px solid #555;\r\n        padding: 4px 3px;\r\n        vertical-align: middle;\r\n        font-size: 8px;\r\n        word-wrap: break-word;\r\n    }\r\n\r\n    .payment-table th:nth-child(1) {\r\n        width: 5%;\r\n    }\r\n\r\n    .payment-table th:nth-child(2) {\r\n        width: 22%;\r\n    }\r\n\r\n    .payment-table th:nth-child(3) {\r\n        width: 8%;\r\n    }\r\n\r\n    .payment-table th:nth-child(4) {\r\n        width: 8%;\r\n    }\r\n\r\n    .payment-table th:nth-child(5) {\r\n        width: 14%;\r\n    }\r\n\r\n    .payment-table th:nth-child(6) {\r\n        width: 15%;\r\n    }\r\n\r\n    .payment-table th:nth-child(7) {\r\n        width: 13%;\r\n    }\r\n\r\n    .payment-table th:nth-child(8) {\r\n        width: 15%;\r\n    }\r\n\r\n    .text-center {\r\n        text-align: center;\r\n    }\r\n\r\n    .text-right {\r\n        text-align: right;\r\n    }\r\n\r\n    .text-left {\r\n        text-align: left;\r\n    }\r\n\r\n    /* =====================================================\r\n       TOTALS\r\n       ===================================================== */\r\n\r\n    .totals-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-top: 0;\r\n    }\r\n\r\n    .totals-table td {\r\n        border: 1px solid #555;\r\n        padding: 6px;\r\n    }\r\n\r\n    .totals-label {\r\n        width: 72%;\r\n        text-align: right;\r\n        font-weight: bold;\r\n        background: #f2f2f2;\r\n    }\r\n\r\n    .totals-value {\r\n        width: 28%;\r\n        text-align: right;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .net-row td {\r\n        font-size: 10.5px;\r\n        font-weight: bold;\r\n        background: #e7e7e7;\r\n    }\r\n\r\n    /* =====================================================\r\n       PAYMENT DISTRIBUTION\r\n       ===================================================== */\r\n\r\n    .distribution-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .distribution-table thead {\r\n        display: table-header-group;\r\n    }\r\n\r\n    .distribution-table th {\r\n        border: 1px solid #333;\r\n        background: #e8e8e8;\r\n        padding: 5px;\r\n        text-align: center;\r\n        font-size: 8.5px;\r\n    }\r\n\r\n    .distribution-table td {\r\n        border: 1px solid #555;\r\n        padding: 5px;\r\n        font-size: 8.5px;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .distribution-table th:nth-child(1) {\r\n        width: 8%;\r\n    }\r\n\r\n    .distribution-table th:nth-child(2) {\r\n        width: 52%;\r\n    }\r\n\r\n    .distribution-table th:nth-child(3) {\r\n        width: 22%;\r\n    }\r\n\r\n    .distribution-table th:nth-child(4) {\r\n        width: 18%;\r\n    }\r\n\r\n    /* =====================================================\r\n       SIGNATURE / APPROVAL SECTION\r\n       ===================================================== */\r\n\r\n    .signature-section {\r\n        margin-top: 15px;\r\n        page-break-inside: avoid;\r\n        break-inside: avoid;\r\n    }\r\n\r\n    .signature-table {\r\n        width: 100%;\r\n        border-collapse: separate;\r\n        border-spacing: 7px 0;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .signature-table td {\r\n        width: 33.333%;\r\n        padding: 0;\r\n        vertical-align: top;\r\n        border: none;\r\n    }\r\n\r\n    .signature-box {\r\n        border: 1px solid #555;\r\n        min-height: 122px;\r\n        padding: 8px;\r\n        page-break-inside: avoid;\r\n        break-inside: avoid;\r\n    }\r\n\r\n    .signature-title {\r\n        text-align: center;\r\n        font-weight: bold;\r\n        font-size: 9px;\r\n        text-transform: uppercase;\r\n        border-bottom: 1px solid #777;\r\n        padding-bottom: 5px;\r\n        margin-bottom: 9px;\r\n    }\r\n\r\n    .signature-row {\r\n        margin-top: 7px;\r\n        font-size: 8.5px;\r\n        min-height: 18px;\r\n    }\r\n\r\n    .signature-label {\r\n        font-weight: bold;\r\n    }\r\n\r\n    .signature-image {\r\n        max-width: 115px;\r\n        max-height: 38px;\r\n        object-fit: contain;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    /* =====================================================\r\n       FOOTER\r\n       ===================================================== */\r\n\r\n    .document-footer {\r\n        width: 100%;\r\n        border-top: 1px solid #333;\r\n        padding-top: 4px;\r\n        margin-top: 10px;\r\n        font-size: 7.5px;\r\n        text-align: center;\r\n    }\r\n\r\n    /* =====================================================\r\n       PAGE CONTROL\r\n       ===================================================== */\r\n\r\n    tr {\r\n        page-break-inside: avoid;\r\n    }\r\n\r\n    table {\r\n        page-break-inside: auto;\r\n    }\r\n\r\n    thead {\r\n        display: table-header-group;\r\n    }\r\n\r\n    tfoot {\r\n        display: table-footer-group;\r\n    }\r\n\r\n    .no-break {\r\n        page-break-inside: avoid;\r\n        break-inside: avoid;\r\n    }\r\n\r\n    .amount-number {\r\n        white-space: nowrap;\r\n    }\r\n</style>\r\n\r\n\r\n<!-- =========================================================\r\n     CALCULATE TOTALS\r\n     ========================================================= -->\r\n\r\n{% set ns = namespace(\r\n    gross_total = 0,\r\n    income_tax_total = 0,\r\n    net_total = 0\r\n) %}\r\n\r\n{% for row in doc.contract_work_payment_form_table or [] %}\r\n\r\n    {% set qty = row.qty or 0 %}\r\n    {% set unit_price = row.unit_price or 0 %}\r\n    {% set income_tax = row.income_tax or 0 %}\r\n\r\n    {% set calculated_gross = qty * unit_price %}\r\n    {% set calculated_net = calculated_gross - income_tax %}\r\n\r\n    {% set ns.gross_total = ns.gross_total + calculated_gross %}\r\n    {% set ns.income_tax_total = ns.income_tax_total + income_tax %}\r\n    {% set ns.net_total = ns.net_total + calculated_net %}\r\n\r\n{% endfor %}\r\n\r\n\r\n<!-- =========================================================\r\n     COMPANY HEADER\r\n     ========================================================= -->\r\n\r\n<div class=\"company-header\">\r\n\r\n    <table class=\"header-table\">\r\n        <tr>\r\n\r\n            <!-- LOGO -->\r\n            <td class=\"header-logo\">\r\n                <img\r\n                    src=\"/files/wwc-logo-new.png\"\r\n                    class=\"logo\"\r\n                >\r\n            </td>\r\n\r\n            <!-- COMPANY INFORMATION -->\r\n            <td class=\"header-company\">\r\n\r\n                <div class=\"company-name\">\r\n                    WATER WORKS CORPORATION\r\n                </div>\r\n\r\n                <div class=\"company-subtitle\">\r\n                    CONTRACT WORK PAYMENT FORM\r\n                </div>\r\n\r\n                <div class=\"company-address\">\r\n                    Official Payment and Authorization Document\r\n                </div>\r\n\r\n            </td>\r\n\r\n            <!-- DOCUMENT INFORMATION -->\r\n            <td class=\"header-right\">\r\n\r\n                <div>\r\n                    <b>Document No:</b>\r\n                    <br>\r\n                    {{ doc.name }}\r\n                </div>\r\n\r\n                <div style=\"margin-top:5px;\">\r\n                    <b>Request Date:</b>\r\n                    <br>\r\n                    {{ frappe.utils.formatdate(doc.requested_date)\r\n                       if doc.requested_date else \"\" }}\r\n                </div>\r\n\r\n            </td>\r\n\r\n        </tr>\r\n    </table>\r\n\r\n</div>\r\n\r\n\r\n<!-- =========================================================\r\n     DOCUMENT TITLE\r\n     ========================================================= -->\r\n\r\n<div class=\"document-title\">\r\n    CONTRACT WORK PAYMENT FORM\r\n</div>\r\n\r\n\r\n<!-- =========================================================\r\n     GENERAL INFORMATION\r\n     ========================================================= -->\r\n\r\n<table class=\"info-table\">\r\n\r\n    <tr>\r\n\r\n        <td class=\"info-label\">\r\n            Department\r\n        </td>\r\n\r\n        <td class=\"info-value\">\r\n            {{ doc.department or \"\" }}\r\n        </td>\r\n\r\n        <td class=\"info-label\">\r\n            Department Head\r\n        </td>\r\n\r\n        <td class=\"info-value\">\r\n            {{ doc.department_head or \"\" }}\r\n        </td>\r\n\r\n    </tr>\r\n\r\n    <tr>\r\n\r\n        <td class=\"info-label\">\r\n            Project Name\r\n        </td>\r\n\r\n        <td class=\"info-value\">\r\n            {{ doc.project_name or \"\" }}\r\n        </td>\r\n\r\n        <td class=\"info-label\">\r\n            Request Date\r\n        </td>\r\n\r\n        <td class=\"info-value\">\r\n            {{ frappe.utils.formatdate(doc.requested_date)\r\n               if doc.requested_date else \"\" }}\r\n        </td>\r\n\r\n    </tr>\r\n\r\n    <tr>\r\n\r\n        <td class=\"info-label\">\r\n            Purpose\r\n        </td>\r\n\r\n        <td colspan=\"3\" class=\"info-value\">\r\n            {{ doc.purpose or \"\" }}\r\n        </td>\r\n\r\n    </tr>\r\n\r\n</table>\r\n\r\n\r\n<!-- =========================================================\r\n     CONTRACT WORK PAYMENT DETAILS\r\n     ========================================================= -->\r\n\r\n<div class=\"section-title\">\r\n    Contract Work Payment Details\r\n</div>\r\n\r\n\r\n<table class=\"payment-table\">\r\n\r\n    <thead>\r\n        <tr>\r\n\r\n            <th>No.</th>\r\n\r\n            <th>\r\n                Work Type\r\n            </th>\r\n\r\n            <th>\r\n                UOM\r\n            </th>\r\n\r\n            <th>\r\n                Qty\r\n            </th>\r\n\r\n            <th>\r\n                Unit Price\r\n            </th>\r\n\r\n            <th>\r\n                Gross Amount\r\n            </th>\r\n\r\n            <th>\r\n                Income Tax\r\n            </th>\r\n\r\n            <th>\r\n                Net Amount\r\n            </th>\r\n\r\n        </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n\r\n        {% for row in doc.contract_work_payment_form_table or [] %}\r\n\r\n            {% set qty = row.qty or 0 %}\r\n            {% set unit_price = row.unit_price or 0 %}\r\n            {% set income_tax = row.income_tax or 0 %}\r\n\r\n            {% set calculated_gross = qty * unit_price %}\r\n            {% set calculated_net = calculated_gross - income_tax %}\r\n\r\n            <tr>\r\n\r\n                <td class=\"text-center\">\r\n                    {{ loop.index }}\r\n                </td>\r\n\r\n                <td class=\"text-left\">\r\n                    {{ row.work_type or \"\" }}\r\n                </td>\r\n\r\n                <td class=\"text-center\">\r\n                    {{ row.uom or \"\" }}\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n                    <span class=\"amount-number\">\r\n                        {{ frappe.utils.fmt_money(\r\n                            qty,\r\n                            precision=2\r\n                        ) }}\r\n                    </span>\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n                    <span class=\"amount-number\">\r\n                        {{ frappe.utils.fmt_money(\r\n                            unit_price,\r\n                            precision=2\r\n                        ) }}\r\n                    </span>\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n                    <span class=\"amount-number\">\r\n                        {{ frappe.utils.fmt_money(\r\n                            calculated_gross,\r\n                            precision=2\r\n                        ) }}\r\n                    </span>\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n                    <span class=\"amount-number\">\r\n                        {{ frappe.utils.fmt_money(\r\n                            income_tax,\r\n                            precision=2\r\n                        ) }}\r\n                    </span>\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n                    <span class=\"amount-number\">\r\n                        {{ frappe.utils.fmt_money(\r\n                            calculated_net,\r\n                            precision=2\r\n                        ) }}\r\n                    </span>\r\n                </td>\r\n\r\n            </tr>\r\n\r\n        {% endfor %}\r\n\r\n\r\n        {% if not doc.contract_work_payment_form_table %}\r\n\r\n            <tr>\r\n\r\n                <td\r\n                    colspan=\"8\"\r\n                    class=\"text-center\"\r\n                    style=\"height:40px;\"\r\n                >\r\n                    No work payment details available.\r\n                </td>\r\n\r\n            </tr>\r\n\r\n        {% endif %}\r\n\r\n    </tbody>\r\n\r\n</table>\r\n\r\n\r\n<!-- =========================================================\r\n     TOTALS\r\n     ========================================================= -->\r\n\r\n<table class=\"totals-table\">\r\n\r\n    <tr>\r\n\r\n        <td class=\"totals-label\">\r\n            Total Gross Amount\r\n        </td>\r\n\r\n        <td class=\"totals-value\">\r\n            {{ frappe.utils.fmt_money(\r\n                ns.gross_total,\r\n                precision=2\r\n            ) }}\r\n        </td>\r\n\r\n    </tr>\r\n\r\n    <tr>\r\n\r\n        <td class=\"totals-label\">\r\n            Total Income Tax\r\n        </td>\r\n\r\n        <td class=\"totals-value\">\r\n            {{ frappe.utils.fmt_money(\r\n                ns.income_tax_total,\r\n                precision=2\r\n            ) }}\r\n        </td>\r\n\r\n    </tr>\r\n\r\n    <tr class=\"net-row\">\r\n\r\n        <td class=\"totals-label\">\r\n            TOTAL NET AMOUNT PAYABLE\r\n        </td>\r\n\r\n        <td class=\"totals-value\">\r\n            {{ frappe.utils.fmt_money(\r\n                ns.net_total,\r\n                precision=2\r\n            ) }}\r\n        </td>\r\n\r\n    </tr>\r\n\r\n</table>\r\n\r\n\r\n<!-- =========================================================\r\n     PAYMENT DISTRIBUTION\r\n     ========================================================= -->\r\n\r\n<div class=\"section-title\">\r\n    Payment Distribution\r\n</div>\r\n\r\n\r\n{% set distribution_ns = namespace(\r\n    total = 0\r\n) %}\r\n\r\n\r\n<table class=\"distribution-table\">\r\n\r\n    <thead>\r\n        <tr>\r\n\r\n            <th>\r\n                No.\r\n            </th>\r\n\r\n            <th>\r\n                Full Name\r\n            </th>\r\n\r\n            <th>\r\n                Amount\r\n            </th>\r\n\r\n            <th>\r\n                Signature\r\n            </th>\r\n\r\n        </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n\r\n        {% for row in doc.contract_work_payment_table or [] %}\r\n\r\n            {% set distribution_ns.total =\r\n                distribution_ns.total + (row.amount or 0)\r\n            %}\r\n\r\n            <tr>\r\n\r\n                <td class=\"text-center\">\r\n                    {{ loop.index }}\r\n                </td>\r\n\r\n                <td>\r\n                    {{ row.full_name or \"\" }}\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n                    {{ frappe.utils.fmt_money(\r\n                        row.amount or 0,\r\n                        precision=2\r\n                    ) }}\r\n                </td>\r\n\r\n                <td style=\"height:35px;\">\r\n\r\n                    {% if row.sign %}\r\n                        {{ row.sign }}\r\n                    {% endif %}\r\n\r\n                </td>\r\n\r\n            </tr>\r\n\r\n        {% endfor %}\r\n\r\n\r\n        {% if not doc.contract_work_payment_table %}\r\n\r\n            <tr>\r\n\r\n                <td\r\n                    colspan=\"4\"\r\n                    class=\"text-center\"\r\n                    style=\"height:40px;\"\r\n                >\r\n                    No payment distribution details available.\r\n                </td>\r\n\r\n            </tr>\r\n\r\n        {% endif %}\r\n\r\n\r\n        <!-- DISTRIBUTION TOTAL -->\r\n\r\n        <tr>\r\n\r\n            <td\r\n                colspan=\"2\"\r\n                class=\"text-right\"\r\n            >\r\n                <b>\r\n                    Total Distributed Amount\r\n                </b>\r\n            </td>\r\n\r\n            <td class=\"text-right\">\r\n                <b>\r\n                    {{ frappe.utils.fmt_money(\r\n                        distribution_ns.total,\r\n                        precision=2\r\n                    ) }}\r\n                </b>\r\n            </td>\r\n\r\n            <td></td>\r\n\r\n        </tr>\r\n\r\n    </tbody>\r\n\r\n</table>\r\n\r\n\r\n<!-- =========================================================\r\n     APPROVAL SECTION\r\n     ========================================================= -->\r\n\r\n<div class=\"signature-section\">\r\n\r\n    <table class=\"signature-table\">\r\n\r\n        <tr>\r\n\r\n            <!-- REQUESTER -->\r\n\r\n            <td>\r\n\r\n                <div class=\"signature-box\">\r\n\r\n                    <div class=\"signature-title\">\r\n                        Requested By\r\n                    </div>\r\n\r\n                    <div class=\"signature-row\">\r\n                        <span class=\"signature-label\">\r\n                            Name:\r\n                        </span>\r\n                        <br>\r\n                        {{ doc.requested_by or \"\" }}\r\n                    </div>\r\n\r\n                    <div class=\"signature-row\">\r\n                        <span class=\"signature-label\">\r\n                            Signature:\r\n                        </span>\r\n\r\n                        {% if doc.requester_signature %}\r\n                            <br>\r\n                            <img\r\n                                src=\"{{ doc.requester_signature }}\"\r\n                                class=\"signature-image\"\r\n                            >\r\n                        {% endif %}\r\n                    </div>\r\n\r\n                    <div class=\"signature-row\">\r\n                        <span class=\"signature-label\">\r\n                            Date:\r\n                        </span>\r\n                        <br>\r\n                        {{ frappe.utils.formatdate(\r\n                            doc.requested_date\r\n                        ) if doc.requested_date else \"\" }}\r\n                    </div>\r\n\r\n                </div>\r\n\r\n            </td>\r\n\r\n\r\n            <!-- AUTHORIZER -->\r\n\r\n            <td>\r\n\r\n                <div class=\"signature-box\">\r\n\r\n                    <div class=\"signature-title\">\r\n                        Authorized By\r\n                    </div>\r\n\r\n                    <div class=\"signature-row\">\r\n                        <span class=\"signature-label\">\r\n                            Name:\r\n                        </span>\r\n                        <br>\r\n                        {{ doc.authorized_by or \"\" }}\r\n                    </div>\r\n\r\n                    <div class=\"signature-row\">\r\n                        <span class=\"signature-label\">\r\n                            Signature:\r\n                        </span>\r\n\r\n                        {% if doc.authorized_signature %}\r\n                            <br>\r\n                            <img\r\n                                src=\"{{ doc.authorized_signature }}\"\r\n                                class=\"sig