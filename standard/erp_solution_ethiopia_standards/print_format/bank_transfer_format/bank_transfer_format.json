 "html": "<div class=\"print-format bank-transfer-letter\">\r\n    <style>\r\n        .bank-transfer-letter {\r\n            font-family: \"Noto Sans Ethiopic\", \"Nyala\", Arial, sans-serif;\r\n            font-size: 12pt;\r\n            color: #000;\r\n            line-height: 1.6;\r\n            padding-bottom: 60px; /* keep content clear of the fixed footer */\r\n        }\r\n\r\n        .bank-transfer-letter table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n\r\n        /* ================= HEADER (elegant, centered) ================= */\r\n        .letterhead {\r\n            text-align: center;\r\n            margin-bottom: 8px;\r\n        }\r\n\r\n        .letterhead .logo {\r\n            max-height: 78px;\r\n            max-width: 100px;\r\n            margin-bottom: 6px;\r\n        }\r\n\r\n        .letterhead .org-name-am {\r\n            font-size: 15pt;\r\n            font-weight: 700;\r\n            letter-spacing: 0.5px;\r\n            margin: 2px 0 0 0;\r\n        }\r\n\r\n        .letterhead .org-name-en {\r\n            font-size: 13.5pt;\r\n            font-weight: 700;\r\n            text-transform: uppercase;\r\n            letter-spacing: 1.8px;\r\n            margin: 2px 0 0 0;\r\n        }\r\n\r\n        .letterhead .org-subtitle {\r\n            font-size: 10pt;\r\n            font-style: italic;\r\n            color: #444;\r\n            letter-spacing: 0.4px;\r\n            margin: 2px 0 0 0;\r\n        }\r\n\r\n        .letterhead-rule {\r\n            border: none;\r\n            border-top: 2px solid #000;\r\n            margin: 8px 0 2px 0;\r\n        }\r\n\r\n        .letterhead-rule.thin {\r\n            border-top: 1px solid #000;\r\n            margin: 2px 0 6px 0;\r\n        }\r\n\r\n        .contact-bar {\r\n            text-align: center;\r\n            font-size: 9.5pt;\r\n            letter-spacing: 0.2px;\r\n            color: #222;\r\n            margin-bottom: 16px;\r\n        }\r\n\r\n        /* ================= REF/DATE (top right) then TO (left, below) ================= */\r\n        .ref-date-block {\r\n            text-align: right;\r\n            margin-bottom: 16px;\r\n        }\r\n\r\n        .ref-date-block .row-line {\r\n            margin: 0 0 6px 0;\r\n            font-size: 11.5pt;\r\n        }\r\n\r\n        .ref-date-block .label {\r\n            font-weight: bold;\r\n        }\r\n\r\n        .ref-date-block .value {\r\n            display: inline-block;\r\n            min-width: 140px;\r\n            border-bottom: 1px dotted #000;\r\n            padding-left: 6px;\r\n            text-align: left;\r\n        }\r\n\r\n        .to-block {\r\n            text-align: left;\r\n            margin-bottom: 18px;\r\n        }\r\n\r\n        .to-block .to-line {\r\n            margin: 0 0 2px 0;\r\n            font-weight: bold;\r\n            font-size: 12pt;\r\n        }\r\n\r\n        /* ================= SUBJECT (centered) ================= */\r\n        .subject-line {\r\n            font-weight: bold;\r\n            text-decoration: underline;\r\n            text-align: center;\r\n            margin: 10px 0 18px 0;\r\n            font-size: 12.5pt;\r\n        }\r\n\r\n        /* ================= BODY ================= */\r\n        .letter-body {\r\n            text-align: justify;\r\n            margin-bottom: 30px;\r\n            font-size: 12pt;\r\n        }\r\n\r\n        .letter-body p {\r\n            margin: 0 0 10px 0;\r\n        }\r\n\r\n        /* ================= SIGNATURE ================= */\r\n        .sign-table {\r\n            margin-top: 40px;\r\n        }\r\n\r\n        .sign-table td {\r\n            vertical-align: bottom;\r\n        }\r\n\r\n        .sign-left {\r\n            width: 50%;\r\n        }\r\n\r\n        .sign-right {\r\n            width: 50%;\r\n            text-align: right;\r\n            font-weight: bold;\r\n        }\r\n\r\n        .sign-space {\r\n            height: 50px;\r\n        }\r\n\r\n        /* ================= CC BLOCK ================= */\r\n        .cc-block {\r\n            margin-top: 40px;\r\n            font-size: 11.5pt;\r\n        }\r\n\r\n        .cc-title {\r\n            font-weight: bold;\r\n            text-decoration: underline;\r\n            margin-bottom: 6px;\r\n        }\r\n\r\n        .cc-block .cc-item {\r\n            margin: 2px 0;\r\n        }\r\n\r\n        .cc-block .cc-item:before {\r\n            content: \"\\2713  \";\r\n        }\r\n\r\n        /* ================= FOOTER (fixed, repeats on every page) ================= */\r\n        .footer-bar {\r\n            position: fixed;\r\n            bottom: 0;\r\n            left: 0;\r\n            right: 0;\r\n            border-top: 2px solid #000;\r\n            padding-top: 4px;\r\n            font-size: 9.5pt;\r\n            text-align: center;\r\n            background: #fff;\r\n        }\r\n    </style>\r\n\r\n    <!-- ================= HEADER ================= -->\r\n    <div class=\"letterhead\">\r\n        <img src=\"/files/wwc-logo-new.png\" class=\"logo\">\r\n        <div class=\"org-name-am\">\u12cd\u1283 \u1235\u122b\u12ce\u127d \u12ae\u122d\u1356\u122c\u123d\u1295</div>\r\n        <div class=\"org-name-en\">Water Works Corporation</div>\r\n        <div class=\"org-subtitle\">Corporate Finance Main Directorate &nbsp;|&nbsp; \u12ae\u122d\u1356\u122c\u1275 \u134b\u12ed\u1293\u1295\u1235 \u12cb\u1293 \u12f2\u1353\u122d\u1275\u1218\u1295\u1275</div>\r\n    </div>\r\n    <hr class=\"letterhead-rule\">\r\n    <hr class=\"letterhead-rule thin\">\r\n\r\n    <div class=\"contact-bar\">\r\n        &#9742;&nbsp;251-58-220-0480 &nbsp;&nbsp;|&nbsp;&nbsp; Fax&nbsp;251-58-220-6168 &nbsp;&nbsp;|&nbsp;&nbsp;\r\n        awwce@telecom.net.et &nbsp;&nbsp;|&nbsp;&nbsp; www.awwce.com.et\r\n    </div>\r\n\r\n    <!-- ================= REF/DATE (top right) ================= -->\r\n    <div class=\"ref-date-block\">\r\n        <p class=\"row-line\"><span class=\"label\">Ref. No / \u1241\u1325\u122d</span><span class=\"value\">{{ doc.ref_no or \"\" }}</span></p>\r\n        <p class=\"row-line\"><span class=\"label\">Date / \u1240\u1295</span><span class=\"value\">{{ frappe.utils.formatdate(doc.date) if doc.date else \"\" }}</span></p>\r\n    </div>\r\n\r\n    <!-- ================= TO (left, below ref/date) ================= -->\r\n    <div class=\"to-block\">\r\n        {% for line in (doc.to or \"\").split(\"\\n\") %}\r\n        <p class=\"to-line\">{{ line }}</p>\r\n        {% endfor %}\r\n    </div>\r\n\r\n    <!-- ================= SUBJECT ================= -->\r\n    <div class=\"subject-line\">\r\n        \u1309\u12f3\u12ed\u1366 {{ doc.purpose or \"\" }}\r\n    </div>\r\n\r\n    <!-- ================= BODY ================= -->\r\n    <div class=\"letter-body\">\r\n        <p>{{ doc.description or \"\" }}</p>\r\n    </div>\r\n\r\n    <!-- ================= SIGNATURE ================= -->\r\n    <table class=\"sign-table\">\r\n        <tr>\r\n            <td class=\"sign-left\">\r\n                <div class=\"sign-space\"></div>\r\n            </td>\r\n            <td class=\"sign-right\">\r\n                \"\u12a8\u1230\u120b\u121d\u1273 \u130b\u122d\"\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ================= CC ================= -->\r\n    {% if doc.cc %}\r\n    <div class=\"cc-block\">\r\n        <div class=\"cc-title\">\u130d\u120d\u1263\u132d</div>\r\n        {% for line in doc.cc.split(\"\\n\") %}\r\n        <div class=\"cc-item\">{{ line }}</div>\r\n        {% endfor %}\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ================= FOOTER (constant on every page) ================= -->\r\n    <div class=\"footer-bar\">\r\n        &#9742;:- 058-226-33-59 &nbsp;&nbsp; Fax:- 058-226-60-11 / 058-226-64-72 / 058-226-33-57 &nbsp;&nbsp; &#9993; - 106\r\n    </div>\r\n</div>",
