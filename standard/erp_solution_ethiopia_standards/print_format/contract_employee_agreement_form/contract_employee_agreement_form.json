 "html": "<style>\r\n    /* =========================================================\r\n       PAGE SETUP\r\n       ========================================================= */\r\n    @page {\r\n        size: A4;\r\n        margin: 18mm 18mm 20mm 18mm;\r\n    }\r\n\r\n    .contract-agreement {\r\n        font-family: \"Noto Sans Ethiopic\",\r\n                     \"Abyssinica SIL\",\r\n                     \"Nyala\",\r\n                     Arial,\r\n                     sans-serif;\r\n        color: #111;\r\n        font-size: 13px;\r\n        line-height: 1.7;\r\n        width: 100%;\r\n    }\r\n\r\n    /* =========================================================\r\n       HEADER\r\n       ========================================================= */\r\n    .header {\r\n        text-align: center;\r\n        margin-bottom: 12px;\r\n    }\r\n\r\n    .header-amharic {\r\n        font-size: 18px;\r\n        font-weight: bold;\r\n        text-decoration: underline;\r\n        margin-bottom: 2px;\r\n    }\r\n\r\n    .header-english {\r\n        font-family: Arial, sans-serif;\r\n        font-size: 16px;\r\n        font-weight: bold;\r\n        text-decoration: underline;\r\n        margin-bottom: 16px;\r\n    }\r\n\r\n    .document-title {\r\n        font-size: 17px;\r\n        font-weight: bold;\r\n        text-decoration: underline;\r\n        margin-top: 8px;\r\n        margin-bottom: 18px;\r\n    }\r\n\r\n    /* =========================================================\r\n       DESCRIPTION\r\n       ========================================================= */\r\n    .description {\r\n        text-align: justify;\r\n        margin-top: 8px;\r\n        margin-bottom: 16px;\r\n        line-height: 2;\r\n        font-size: 13px;\r\n    }\r\n\r\n    /* =========================================================\r\n       INFORMATION SECTION\r\n       ========================================================= */\r\n    .info-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-bottom: 15px;\r\n    }\r\n\r\n    .info-table td {\r\n        padding: 2px 0;\r\n        vertical-align: bottom;\r\n    }\r\n\r\n    .info-label {\r\n        width: 90px;\r\n        font-weight: bold;\r\n        white-space: nowrap;\r\n    }\r\n\r\n    .info-value {\r\n        border-bottom: 1px dotted #555;\r\n        min-width: 180px;\r\n        padding-left: 8px;\r\n    }\r\n\r\n    /* =========================================================\r\n       MAIN EMPLOYEE TABLE\r\n       ========================================================= */\r\n    .employee-section {\r\n        margin-top: 12px;\r\n    }\r\n\r\n    .employee-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .employee-table th {\r\n        font-weight: bold;\r\n        text-align: center;\r\n        padding: 5px 4px;\r\n        border-bottom: 1px solid #333;\r\n    }\r\n\r\n    .employee-table td {\r\n        padding: 5px 4px;\r\n        height: 28px;\r\n        vertical-align: bottom;\r\n    }\r\n\r\n    .employee-number {\r\n        width: 45px;\r\n        text-align: center;\r\n    }\r\n\r\n    .employee-name {\r\n        width: 55%;\r\n    }\r\n\r\n    .employee-sign {\r\n        width: 35%;\r\n    }\r\n\r\n    .dotted-line {\r\n        border-bottom: 1px dotted #555;\r\n        height: 20px;\r\n    }\r\n\r\n    /* =========================================================\r\n       WITNESS SECTION\r\n       ========================================================= */\r\n    .witness-section {\r\n        margin-top: 30px;\r\n        page-break-inside: avoid;\r\n    }\r\n\r\n    .section-title {\r\n        text-align: center;\r\n        font-size: 15px;\r\n        font-weight: bold;\r\n        text-decoration: underline;\r\n        margin-bottom: 14px;\r\n    }\r\n\r\n    .witness-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .witness-table th {\r\n        text-align: center;\r\n        font-weight: bold;\r\n        padding: 4px;\r\n    }\r\n\r\n    .witness-table td {\r\n        padding: 5px 4px;\r\n        height: 28px;\r\n        vertical-align: bottom;\r\n    }\r\n\r\n    .witness-number {\r\n        width: 45px;\r\n        text-align: center;\r\n    }\r\n\r\n    .witness-name {\r\n        width: 55%;\r\n    }\r\n\r\n    .witness-sign {\r\n        width: 35%;\r\n    }\r\n\r\n    /* =========================================================\r\n       FOOTER LINE\r\n       ========================================================= */\r\n    .footer-line {\r\n        margin-top: 55px;\r\n        border-top: 2px solid #222;\r\n        width: 85%;\r\n        margin-left: auto;\r\n        margin-right: auto;\r\n    }\r\n\r\n    /* =========================================================\r\n       PRINT\r\n       ========================================================= */\r\n    @media print {\r\n        .contract-agreement {\r\n            page-break-after: auto;\r\n        }\r\n\r\n        .employee-table,\r\n        .witness-table {\r\n            page-break-inside: avoid;\r\n        }\r\n\r\n        tr {\r\n            page-break-inside: avoid;\r\n        }\r\n    }\r\n</style>\r\n\r\n\r\n<div class=\"contract-agreement\">\r\n\r\n    <!-- =====================================================\r\n         HEADER\r\n         ===================================================== -->\r\n    <div class=\"header\">\r\n\r\n        <div class=\"header-amharic\">\r\n            \u12cd\u1203 \u1235\u122b\u12ce\u127d \u12ae\u122d\u1356\u122c\u123d\u1295\r\n        </div>\r\n\r\n        <div class=\"header-english\">\r\n            Water Works Corporation\r\n        </div>\r\n\r\n        <div class=\"document-title\">\r\n            \u12e8\u12ae\u1295\u1275\u122b\u1275 \u1230\u122b\u1270\u129b \u1235\u121d\u121d\u1290\u1275 \u1245\u133d\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =====================================================\r\n         DESCRIPTION\r\n         ===================================================== -->\r\n    <div class=\"description\">\r\n        {{ doc.description or \"\" }}\r\n    </div>\r\n\r\n\r\n    <!-- =====================================================\r\n         INFORMATION\r\n         ===================================================== -->\r\n    <table class=\"info-table\">\r\n\r\n        <tr>\r\n            <td class=\"info-label\">\r\n                \u12c8\u120d \u1230\u132d :\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.wole_seche or \"\" }}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"info-label\">\r\n                \u1240\u1295:\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ frappe.utils.formatdate(doc.date) if doc.date else \"\" }}\r\n            </td>\r\n        </tr>\r\n\r\n    </table>\r\n\r\n\r\n    <!-- =====================================================\r\n         CONTRACT EMPLOYEE LIST\r\n         Contract Employee Agreement Table\r\n         ===================================================== -->\r\n    <div class=\"employee-section\">\r\n\r\n        <table class=\"employee-table\">\r\n\r\n            <thead>\r\n                <tr>\r\n                    <th class=\"employee-number\">\r\n                        \u1241\u1325\u122d\r\n                    </th>\r\n\r\n                    <th class=\"employee-name\">\r\n                        \u12e8\u12ae\u1295\u1275\u122b\u1275 \u1230\u122b\u1270\u129b \u1219\u1209 \u1235\u121d\r\n                    </th>\r\n\r\n                    <th class=\"employee-sign\">\r\n                        \u134a\u122d\u121b\r\n                    </th>\r\n                </tr>\r\n            </thead>\r\n\r\n            <tbody>\r\n\r\n                {% for row in doc.contract_employee_agreement_table %}\r\n\r\n                <tr>\r\n\r\n                    <td class=\"employee-number\">\r\n                        {{ loop.index }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        <div class=\"dotted-line\">\r\n                            {{ row.full_name_of_contract or \"\" }}\r\n                        </div>\r\n                    </td>\r\n\r\n                    <td>\r\n                        <div class=\"dotted-line\">\r\n                            {{ row.sign or \"\" }}\r\n                        </div>\r\n                    </td>\r\n\r\n                </tr>\r\n\r\n                {% endfor %}\r\n\r\n            </tbody>\r\n\r\n        </table>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =====================================================\r\n         WITNESSES\r\n         Contract Employee Agreement Table Two\r\n         ===================================================== -->\r\n    <div class=\"witness-section\">\r\n\r\n        <div class=\"section-title\">\r\n            \u121d\u1235\u12ad\u122e\u127d\r\n        </div>\r\n\r\n        <table class=\"witness-table\">\r\n\r\n            <thead>\r\n                <tr>\r\n\r\n                    <th class=\"witness-number\">\r\n                        \u1241\u1325\u122d\r\n                    </th>\r\n\r\n                    <th class=\"witness-name\">\r\n                        \u1235\u121d\r\n                    </th>\r\n\r\n                    <th class=\"witness-sign\">\r\n                        \u134a\u122d\u121b\r\n                    </th>\r\n\r\n                </tr>\r\n            </thead>\r\n\r\n            <tbody>\r\n\r\n                {% for row in doc.contract_employee_agreement_table_two %}\r\n\r\n                <tr>\r\n\r\n                    <td class=\"witness-number\">\r\n                        {{ loop.index }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        <div class=\"dotted-line\">\r\n                            {{ row.full_name_of_contract or \"\" }}\r\n                        </div>\r\n                    </td>\r\n\r\n                    <td>\r\n                        <div class=\"dotted-line\">\r\n                            {{ row.sign or \"\" }}\r\n                        </div>\r\n                    </td>\r\n\r\n                </tr>\r\n\r\n                {% endfor %}\r\n\r\n            </tbody>\r\n\r\n        </table>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =====================================================\r\n         BOTTOM LINE\r\n         ===================================================== -->\r\n    <div class=\"footer-line\"></div>\r\n\r\n</div>",
