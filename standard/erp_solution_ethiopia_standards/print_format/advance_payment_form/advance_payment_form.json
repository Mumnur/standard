 "font_size": 14,
 "html": "<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 12mm;\r\n    }\r\n\r\n    body {\r\n        font-family: \"Arial\", sans-serif;\r\n        font-size: 12px;\r\n        color: #000;\r\n    }\r\n\r\n    .title{\r\n        text-align:center;\r\n        font-size:22px;\r\n        font-weight:bold;\r\n        margin-bottom:5px;\r\n    }\r\n\r\n    .subtitle{\r\n        text-align:center;\r\n        font-size:14px;\r\n        margin-bottom:20px;\r\n    }\r\n\r\n    table{\r\n        width:100%;\r\n        border-collapse:collapse;\r\n    }\r\n\r\n    .border td,\r\n    .border th{\r\n        border:1px solid #000;\r\n        padding:5px;\r\n    }\r\n\r\n    .no-border td{\r\n        padding:4px;\r\n    }\r\n\r\n    .section-title{\r\n        background:#e8e8e8;\r\n        font-weight:bold;\r\n        text-align:center;\r\n    }\r\n\r\n    .text-right{\r\n        text-align:right;\r\n    }\r\n\r\n    .text-center{\r\n        text-align:center;\r\n    }\r\n\r\n    .signature-box{\r\n        height:70px;\r\n    }\r\n\r\n    .small{\r\n        font-size:11px;\r\n    }\r\n\r\n    .mt20{\r\n        margin-top:20px;\r\n    }\r\n\r\n    .mt10{\r\n        margin-top:10px;\r\n    }\r\n\r\n    .bold{\r\n        font-weight:bold;\r\n    }\r\n\r\n</style>\r\n\r\n<div class=\"title\">\r\n    ADVANCE PAYMENT REQUEST FORM\r\n</div>\r\n\r\n<div class=\"subtitle\">\r\n    Water Works Corporation\r\n</div>\r\n\r\n<table class=\"border\" style=\"margin-bottom:10px;\">\r\n    <tr>\r\n        <td width=\"20%\"><b>Document No.</b></td>\r\n        <td width=\"30%\">{{ doc.name }}</td>\r\n\r\n        <td width=\"20%\"><b>Request Date</b></td>\r\n        <td width=\"30%\">{{ doc.requesting_date or ''}}</td>\r\n    </tr>\r\n</table>\r\n\r\n<table class=\"border\">\r\n\r\n<tr class=\"section-title\">\r\n    <td colspan=\"4\">Employee Information</td>\r\n</tr>\r\n\r\n<tr>\r\n    <td width=\"20%\"><b>Employee ID</b></td>\r\n    <td width=\"30%\">{{ doc.employee_id or ''}}</td>\r\n\r\n    <td width=\"20%\"><b>Employee Name</b></td>\r\n    <td width=\"30%\">{{ doc.employee_name or ''}}</td>\r\n</tr>\r\n\r\n<tr>\r\n    <td><b>Department</b></td>\r\n    <td>{{ doc.department or ''}}</td>\r\n\r\n    <td><b>Designation</b></td>\r\n    <td>{{ doc.designation or ''}}</td>\r\n</tr>\r\n\r\n<tr>\r\n    <td><b>Project</b></td>\r\n    <td>{{ doc.project_name or ''}}</td>\r\n\r\n    <td><b>Monthly Salary</b></td>\r\n    <td>{{ frappe.format_value(doc.salary, {\"fieldtype\":\"Currency\"}) }}</td>\r\n</tr>\r\n\r\n<tr>\r\n    <td><b>Place</b></td>\r\n    <td>{{ doc.place or ''}}</td>\r\n\r\n    <td><b>Request Date</b></td>\r\n    <td>{{ doc.requesting_date or ''}}</td>\r\n</tr>\r\n\r\n<tr>\r\n    <td><b>Transport Type</b></td>\r\n    <td>{{ doc.transport_type or ''}}</td>\r\n\r\n    <td><b>Travel Period</b></td>\r\n    <td>\r\n        {{ doc.planned_from_date or ''}}\r\n        &nbsp;To&nbsp;\r\n        {{ doc.planned_to_date or ''}}\r\n    </td>\r\n</tr>\r\n\r\n</table>\r\n\r\n\r\n<br>\r\n\r\n\r\n<table class=\"border\">\r\n\r\n<tr class=\"section-title\">\r\n    <td width=\"5%\">No</td>\r\n    <td width=\"25%\">Location Type</td>\r\n    <td width=\"15%\">Rate / Day</td>\r\n    <td width=\"15%\">Days</td>\r\n    <td width=\"20%\">Total Amount</td>\r\n    <td width=\"20%\">Remark</td>\r\n</tr>\r\n\r\n{% for row in doc.advance_payment_form_table %}\r\n\r\n<tr>\r\n\r\n<td class=\"text-center\">\r\n{{ loop.index }}\r\n</td>\r\n\r\n<td>\r\n{{ row.location_type or ''}}\r\n</td>\r\n\r\n<td class=\"text-right\">\r\n{{ frappe.format_value(row.rate_per_day, {\"fieldtype\":\"Currency\"}) }}\r\n</td>\r\n\r\n<td class=\"text-center\">\r\n{{ row.no_of_days or ''}}\r\n</td>\r\n\r\n<td class=\"text-right\">\r\n{{ frappe.format_value(row.total_amount, {\"fieldtype\":\"Currency\"}) }}\r\n</td>\r\n\r\n<td>\r\n{{ row.remark or ''}}\r\n</td>\r\n\r\n</tr>\r\n\r\n{% endfor %}\r\n\r\n<tr>\r\n\r\n<td colspan=\"4\" class=\"text-right bold\">\r\nGrand Total\r\n</td>\r\n\r\n<td class=\"text-right bold\">\r\n{{ frappe.format_value(doc.grand_total_amount_in_figure, {\"fieldtype\":\"Currency\"}) }}\r\n</td>\r\n\r\n<td></td>\r\n\r\n</tr>\r\n\r\n</table>\r\n\r\n\r\n<br>\r\n\r\n<table class=\"border\">\r\n\r\n<tr>\r\n\r\n<td>\r\n<b>Total Amount (Words)</b>\r\n</td>\r\n\r\n<td>\r\n{{ doc.grand_total_amount_in_word }}\r\n</td>\r\n\r\n</tr>\r\n\r\n</table>\r\n\r\n\r\n<div class=\"mt20\"></div>\r\n\r\n<table class=\"border\">\r\n\r\n<tr class=\"section-title\">\r\n\r\n<td width=\"33%\">\r\nRequested By\r\n</td>\r\n\r\n<td width=\"33%\">\r\nApproved By\r\n</td>\r\n\r\n<td width=\"34%\">\r\nFinance / Accountant\r\n</td>\r\n\r\n</tr>\r\n\r\n<tr>\r\n\r\n<td class=\"signature-box\">\r\n\r\n<b>Name :</b><br>\r\n\r\n{{ doc.requested_by }}\r\n\r\n<br><br>\r\n\r\n<b>Date :</b>\r\n\r\n{{ doc.requested_date }}\r\n\r\n<br><br>\r\n\r\n{% if doc.requester_signature %}\r\n<img src=\"{{ doc.requester_signature }}\"\r\nstyle=\"height:50px;\">\r\n{% endif %}\r\n\r\n</td>\r\n\r\n<td class=\"signature-box\">\r\n\r\n<b>Name :</b><br>\r\n\r\n{{ doc.approved_by }}\r\n\r\n<br><br>\r\n\r\n<b>Date :</b>\r\n\r\n{{ doc.approved_date }}\r\n\r\n<br><br>\r\n\r\n{% if doc.approver_signature %}\r\n<img src=\"{{ doc.approver_signature }}\"\r\nstyle=\"height:50px;\">\r\n{% endif %}\r\n\r\n</td>\r\n\r\n<td class=\"signature-box\">\r\n\r\n<b>Name :</b><br>\r\n\r\n{{ doc.accountant_name }}\r\n\r\n<br><br>\r\n\r\n<b>Signature</b><br>\r\n\r\n{% if doc.accountant_signature %}\r\n<img src=\"{{ doc.accountant_signature }}\"\r\nstyle=\"height:50px;\">\r\n{% endif %}\r\n\r\n</td>\r\n\r\n</tr>\r\n\r\n</table>\r\n\r\n\r\n<div class=\"mt20 small\">\r\n\r\n<b>Declaration</b>\r\n\r\n<br><br>\r\n\r\nI hereby certify that the above information is correct and I request the advance payment for the stated official purpose. I understand that this advance shall be settled according to the organization's financial policies and procedures.\r\n\r\n</div>",
